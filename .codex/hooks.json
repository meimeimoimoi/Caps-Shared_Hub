{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; [ ! -f \"$d/.agents/skills/impeccable/scripts/impeccable\" ] || \"$d/.agents/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; [ ! -f \"$d/.agents/skills/impeccable/scripts/impeccable\" ] || \"$d/.agents/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; [ ! -f \"$d/.agents/skills/impeccable/scripts/impeccable\" ] || \"$d/.agents/skills/impeccable/scripts/impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
