# Copy to .env.development / .env and adjust
VITE_API_URL=http://localhost:5190
VITE_APP_NAME=Caps Shared Hub

# OAuth client id (Web application) from Google Cloud Console; must match Auth:GoogleClientId in the auth service.
# Authorized JavaScript origins: http://localhost:5173 and http://localhost. Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Expert Portal: mock (development only) or api. Restart Vite after changing.
# Authentication is required in every environment. Production always uses API.
VITE_EXPERT_DATA_SOURCE=mock

# Draft Workspace: API by default. Mock is only available in development.
VITE_DRAFT_DATA_SOURCE=api
VITE_DRAFT_MOCK_SCENARIO=ready
VITE_DRAFT_MOCK_LATENCY_MS=350
# Mock data never bypasses authentication.

# Reviewer workspace: isolated development demo only; production waits for the permissions API.
VITE_REVIEWER_DATA_SOURCE=demo
