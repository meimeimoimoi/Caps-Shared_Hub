# Local project documentation
/docs/

# Local design context, asset backups and test files
/.impeccable/
/FE/src/assets/*.original.png
/FE/src/assets/*.prompt.txt
/FE/src/**/*.test.*
/FE/src/**/*.spec.*

# Build output and local tooling
/.tmp/
**/bin/
**/obj/
# Skill launchers ship prebuilt engines in scripts/bin (not build output)
!/.agents/skills/*/scripts/bin/

# Python virtual environments and installed dependencies
.venv/
venv/
env/
ENV/
__pypackages__/

# Python bytecode and tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/

# Python packaging and coverage output
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
.coverage
.coverage.*
htmlcov/
