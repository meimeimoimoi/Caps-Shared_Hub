# Multi-stage Dockerfile Template for .NET 8 Microservices
# Usage: docker build -f docker/Dockerfile.service --build-arg SERVICE_NAME=auth -t caps-auth:latest .

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG SERVICE_NAME
WORKDIR /src

# Build props + central package versions (required by every project)
COPY ["Directory.Build.props", "Directory.Packages.props", "global.json", "./"]

# Shared libraries (common/Caps.Common.*, common/Caps.Contracts)
COPY common/ common/

# Copy target service project file
COPY ["${SERVICE_NAME}/${SERVICE_NAME}.csproj", "${SERVICE_NAME}/"]

# Restore dependencies
RUN dotnet restore "${SERVICE_NAME}/${SERVICE_NAME}.csproj"

# Copy service source code
COPY ${SERVICE_NAME}/ ${SERVICE_NAME}/

# Build project
WORKDIR "/src/${SERVICE_NAME}"
RUN dotnet build "${SERVICE_NAME}.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "${SERVICE_NAME}.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
# NOTE: exec-form does NOT expand ARG/ENV, so use shell-form here.
# SERVICE_NAME is baked at build time via ARG -> ENV.
ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}
ENTRYPOINT ["sh", "-c", "dotnet ${SERVICE_NAME}.dll"]
