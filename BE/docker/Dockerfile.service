# Multi-stage Dockerfile Template for .NET 8 Microservices
# Usage (single-project service): docker build -f docker/Dockerfile.service --build-arg SERVICE_NAME=gateway -t caps-gateway:latest .
# Usage (layered service): add --build-arg PROJECT=auth/Api/Api.csproj --build-arg APP_NAME=Caps.Auth.Api

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG SERVICE_NAME
# Single-project services use the defaults; layered services (e.g. auth) pass their Api project
ARG PROJECT=${SERVICE_NAME}/${SERVICE_NAME}.csproj
WORKDIR /src

# Build props + central package versions (required by every project)
COPY ["Directory.Build.props", "Directory.Packages.props", "global.json", "./"]

# Shared libraries (common/*)
COPY common/ common/

# Service source (all of its projects)
COPY ${SERVICE_NAME}/ ${SERVICE_NAME}/

RUN dotnet restore "${PROJECT}"
RUN dotnet build "${PROJECT}" -c Release -o /app/build

FROM build AS publish
ARG PROJECT
RUN dotnet publish "${PROJECT}" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
# Exec form cannot expand ARG/ENV, and a shell entrypoint (dash) drops env vars with '-' in their names
# (e.g. ReverseProxy__Clusters__auth-cluster__...). Link the assembly to a fixed name at build time instead.
ARG SERVICE_NAME
ARG APP_NAME=${SERVICE_NAME}
RUN ln -s "${APP_NAME}.dll" service.dll
ENTRYPOINT ["dotnet", "service.dll"]
