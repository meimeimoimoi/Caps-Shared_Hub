# Copy to docker/.env (gitignored) and replace every value before `docker compose up`.
# The role passwords are applied only when the postgres volume is first created; to change them
# later, run scripts/db/service-role.sql again or recreate the volume.
POSTGRES_PASSWORD=change-me-admin
CAPS_AUTH_DB_PASSWORD=change-me-auth
CAPS_EXPERT_DB_PASSWORD=change-me-expert
CAPS_BILLING_DB_PASSWORD=change-me-billing
CAPS_WORKFLOW_DB_PASSWORD=change-me-workflow
CAPS_INGESTION_DB_PASSWORD=change-me-ingestion
