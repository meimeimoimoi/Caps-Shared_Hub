# Copy to docker/.env (gitignored) and replace every placeholder before running docker compose.
# On a VPS, run ./scripts/init-vps.sh after creating .env to generate secrets/jwt-signing-key.pem
# and secrets/seaweedfs-s3.json.

# ── Domain & Registry ──
APP_DOMAIN=caps.example.com
GHCR_OWNER=meimeimoimoi

# ── PostgreSQL (role passwords are applied when the volume is initialized, or via postgres/sync-roles.sh) ──
POSTGRES_PASSWORD=change-me-admin
CAPS_AUTH_DB_PASSWORD=change-me-auth
CAPS_EXPERT_DB_PASSWORD=change-me-expert
CAPS_BILLING_DB_PASSWORD=change-me-billing
CAPS_WORKFLOW_DB_PASSWORD=change-me-workflow
CAPS_INGESTION_DB_PASSWORD=change-me-ingestion
CAPS_NOTIFICATION_DB_PASSWORD=change-me-notification

# ── Redis & RabbitMQ ──
REDIS_PASSWORD=change-me-redis
RABBITMQ_USER=caps_mq
RABBITMQ_PASS=change-me-rabbitmq

# ── SeaweedFS (S3 Object Storage) ──
SEAWEEDFS_ACCESS_KEY=change-me-s3-access
SEAWEEDFS_SECRET_KEY=change-me-s3-secret

# ── Internal Service-to-Service Keys (use random 32+ char strings) ──
INTERNAL_KEY_EXPERT=change-me-internal-expert
INTERNAL_KEY_BILLING=change-me-internal-billing
INTERNAL_KEY_INGESTION=change-me-internal-ingestion
INTERNAL_KEY_RAG=change-me-internal-rag
INTERNAL_KEY_AI=change-me-internal-ai

# ── Auth & Google OAuth ──
# Must match VITE_GOOGLE_CLIENT_ID built into the frontend image (empty disables Google login).
GOOGLE_CLIENT_ID=

# ── Billing & PayOS ──
# Required in Production; changing Billing:AccountHashKey breaks duplicate bank-account detection.
BILLING_ACCOUNT_HASH_KEY=change-me-billing-hash-key
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn

# ── Notification & SMTP (Smtp:Host and Smtp:From are required on startup) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Shared Hub
SMTP_USERNAME=
SMTP_PASSWORD=
DISPUTE_EMAIL=disputes@example.com

# ── AI Engine (Ollama + Qdrant) ──
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3:latest
QDRANT_COLLECTION=tax_knowledge_base
OLLAMA_TIMEOUT_SECONDS=90
QDRANT_TIMEOUT_SECONDS=10
AI_RAG_TIMEOUT_SECONDS=120
AI_WORKFLOW_TIMEOUT_SECONDS=120
