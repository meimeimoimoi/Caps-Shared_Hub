# Copy to docker/.env (gitignored) and replace every value before `docker compose up`.
# The role passwords are applied only when the postgres volume is first created; to change them
# later, run docker/postgres/db/service-role.sql again or recreate the volume.
POSTGRES_PASSWORD=change-me-admin
CAPS_AUTH_DB_PASSWORD=change-me-auth
CAPS_EXPERT_DB_PASSWORD=change-me-expert
CAPS_BILLING_DB_PASSWORD=change-me-billing
CAPS_WORKFLOW_DB_PASSWORD=change-me-workflow
CAPS_INGESTION_DB_PASSWORD=change-me-ingestion
CAPS_NOTIFICATION_DB_PASSWORD=change-me-notification

# Shared key sent via X-Internal-Key from .NET services to ai-service (optional when empty in local dev)
AI_SERVICE_INTERNAL_KEY=

# docker-compose.prod.yml: InternalApi:Key of ingestion, also used by crawler-worker; a long random string
INGESTION_INTERNAL_API_KEY=change-me-ingestion-internal-key

# docker-compose.prod.yml: keys workflow sends to expert and billing (X-Internal-Key); long random strings
EXPERT_INTERNAL_API_KEY=change-me-expert-internal-key
BILLING_INTERNAL_API_KEY=change-me-billing-internal-key

# billing: HMAC key for bank account duplicate checks (at least 32 characters, never change it after first use)
BILLING_ACCOUNT_HASH_KEY=change-me-at-least-32-characters-long
# Public site URL, where PayOS sends users back after a top-up (no trailing slash)
PUBLIC_URL=https://your-domain.example
# PayOS collection channel (kênh thu, top-ups); leave empty to disable payments
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# PayOS payout channel (kênh chi), its own keys; leave empty to disable transfers to experts
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=

# JWT signing key (not an env value): auth reads it from secrets/jwt-signing-key.pem, which is gitignored.
# Create it once, e.g. with the openssl that ships with Git for Windows:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out secrets/jwt-signing-key.pem
