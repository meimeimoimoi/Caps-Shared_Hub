{$APP_DOMAIN} {
    encode zstd gzip

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    handle /api/* {
        reverse_proxy gateway:8080 {
            flush_interval -1
        }
    }

    handle {
        reverse_proxy frontend:80
    }
}
