{
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://localhost:5194"
          }
        }
      },
      "expert-cluster": {
        "Destinations": {
          "expert": {
            "Address": "http://localhost:5198"
          }
        }
      }
    },
    "Routes": {
      "auth-v1": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "users-v1": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "experts-v1": {
        "ClusterId": "expert-cluster",
        "Match": {
          "Path": "/api/v1/experts/{**catch-all}"
        }
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=shared_hub_db;Username=postgres;Password=12345"
  }
}
