{
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://localhost:5194"
          }
        }
      },
      "expert-cluster": {
        "Destinations": {
          "expert": {
            "Address": "http://localhost:5198"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "billing": {
            "Address": "http://localhost:5220"
          }
        }
      }
    },
    "Routes": {
      "auth-v1": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "users-v1": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "experts-v1": {
        "ClusterId": "expert-cluster",
        "Match": {
          "Path": "/api/v1/experts/{**catch-all}"
        }
      },
      "billing-v1": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/v1/billing/{**catch-all}"
        }
      }
    }
  }
}
