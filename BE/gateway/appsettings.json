{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "caps-auth",
    "Audience": "caps-spa",
    "Key": "CHANGE_ME_dev_only_min_32_chars_1234567890"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": { "Address": "http://auth:8080" }
        }
      }
    }
  }
}
