{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "caps-auth",
    "Audience": "caps-api",
    "JwksUrl": "http://localhost:5194/.well-known/jwks.json"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "RateLimits": {
    "AuthPerMinute": 30,
    "ApiPerMinute": 300
  },
  "ReverseProxy": {
    "Routes": {
      "auth-v1": {
        "RateLimiterPolicy": "auth",
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "users-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "users-me-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "AuthSession",
        "Match": {
          "Path": "/api/v1/users/me/{**catch-all}"
        }
      },
      "experts-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "expert-cluster",
        "Match": {
          "Path": "/api/v1/experts/{**catch-all}"
        }
      },
      "marketplace-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "expert-cluster",
        "Match": {
          "Path": "/api/v1/marketplace/{**catch-all}"
        }
      },
      "experts-me-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "expert-cluster",
        "AuthorizationPolicy": "AuthSession",
        "Match": {
          "Path": "/api/v1/experts/me/{**catch-all}"
        }
      },
      "notifications-me-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "AuthSession",
        "Match": {
          "Path": "/api/v1/notifications/me/{**catch-all}"
        }
      },
      "notifications-hub-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/v1/notifications/hub/{**catch-all}"
        }
      },
      "admin-experts-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "expert-cluster",
        "AuthorizationPolicy": "AuthSession",
        "Match": {
          "Path": "/api/v1/admin/experts/{**catch-all}"
        }
      },
      "billing-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/v1/billing/{**catch-all}"
        }
      },
      "billing-wallet-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "billing-cluster",
        "AuthorizationPolicy": "AuthSession",
        "Match": {
          "Path": "/api/v1/billing/wallet/{**catch-all}"
        }
      },
      "billing-bank-accounts-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "billing-cluster",
        "AuthorizationPolicy": "AuthSession",
        "Match": {
          "Path": "/api/v1/billing/bank-accounts/{**catch-all}"
        }
      },
      "admin-billing-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "billing-cluster",
        "AuthorizationPolicy": "AuthSession",
        "Match": {
          "Path": "/api/v1/admin/billing/{**catch-all}"
        }
      },
      "review-cases-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "workflow-cluster",
        "AuthorizationPolicy": "AuthSession",
        "Match": {
          "Path": "/api/v1/review-cases/{**catch-all}"
        }
      },
      "admin-review-cases-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "workflow-cluster",
        "AuthorizationPolicy": "AuthSession",
        "Match": {
          "Path": "/api/v1/admin/review-cases/{**catch-all}"
        }
      },
      "knowledge-hubs-v1": {
        "RateLimiterPolicy": "api",
        "ClusterId": "ingestion-cluster",
        "AuthorizationPolicy": "AuthSession",
        "Match": {
          "Path": "/api/v1/knowledge/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://localhost:5194"
          }
        }
      },
      "expert-cluster": {
        "Destinations": {
          "expert": {
            "Address": "http://localhost:5198"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": {
            "Address": "http://localhost:5100"
          }
        }
      },
      "billing-cluster": {
        "Destinations": {
          "billing": {
            "Address": "http://localhost:5220"
          }
        }
      },
      "ingestion-cluster": {
        "Destinations": {
          "ingestion": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "workflow-cluster": {
        "Destinations": {
          "workflow": {
            "Address": "http://localhost:5030"
          }
        }
      }
    }
  }
}