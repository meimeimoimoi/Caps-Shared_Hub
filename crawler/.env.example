# .env.example
# Copy file này thành ".env" nếu bạn muốn override cấu hình qua biến môi trường
# thay vì sửa trực tiếp config.py. (Tool hiện tại đọc trực tiếp từ config.py,
# file .env này để dành cho việc mở rộng sau - ví dụ nếu thêm proxy, API key...)

# Proxy (nếu cần dùng proxy để tránh rate-limit khi cào số lượng lớn)
# HTTP_PROXY=http://user:pass@proxy-host:port
# HTTPS_PROXY=http://user:pass@proxy-host:port

# Bật/tắt chế độ debug chi tiết hơn
# DEBUG=false
